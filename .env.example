# HTTP server
PORT=3000

# MySQL connection
# Local dev: values below match docker-compose.yml
# Production (Dokploy beta): host is the internal Docker network alias of the
# shared MySQL service, with a dedicated database/user provisioned via
# db/provisioning/beta_setup.sql (see README).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=retogeest_app
DB_PASSWORD=retogeest_dev_password
DB_NAME=retogeest
