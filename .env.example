# HTTP server
PORT=3000

# Required. Clients must send this value in the x-api-key header on every
# endpoint except GET /health. Generate a real random value for production
# (e.g. `openssl rand -hex 32`) — this placeholder is for local dev only.
API_KEY=dev-local-api-key

# Optional. Defaults shown below; generous enough not to interfere with
# normal use. Keyed per API key (falls back to IP if none is sent).
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW=1 minute

# MySQL connection
# Local dev: values below match docker-compose.yml
# Production (Dokploy beta): host is the internal Docker network alias of the
# shared MySQL service, with a dedicated database/user provisioned via
# db/provisioning/beta_setup.sql (see README).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=retogeest_app
DB_PASSWORD=retogeest_dev_password
DB_NAME=retogeest

# Optional. External URL notified (POST) when a task archives. If unset, no
# notification is attempted (see README > Archivado sin duplicados y notificaciones).
# NOTIFY_URL=https://example.com/webhooks/task-archived
