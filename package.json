{
  "name": "retogeest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx db/migrate.ts",
    "migrate:test": "DB_NAME=retogeest_test tsx db/migrate.ts",
    "migrate:create": "tsx db/create-migration.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "mysql2": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
