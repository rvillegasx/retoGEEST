# Used by `npm test` (loaded before .env, see tests/setup.ts).
# Same MySQL instance/user as .env, but a separate database so tests never
# touch dev data. docker-compose.yml's local-init script creates and grants
# this database automatically.
PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=retogeest_app
DB_PASSWORD=retogeest_dev_password
DB_NAME=retogeest_test
